      {
        "type": "list",
        "title": "最新动态",
        "span": 3,
        "source": "news_dataset.published_at",
        "encoding": {
          "title": "title",
          "summary": "summary",
          "image": "image_url",
          "time": "published_at",
          "source": "source",
          "link": "url"
        },
        "config": { "limit": 20 },
        "query": {
          "dataset_id": "ds_news",
          "sort": [{ "column": "published_at", "order": "desc" }],
          "limit": 20
