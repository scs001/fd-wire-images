# wire-postgres 环境模板（cp .env 后填真实值；.env 永不入 git）。
# 当前凭据管理现状：docker compose env_file（本文件派生的 .env）；
# OpenBAO 接管为后续独立任务（README「凭据管理」）。

# ---- 实例凭据（initdb 首次建库时生效；改口令=ALTER USER，见 README）----
POSTGRES_USER=wire
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=wire_platform

# ---- 监听绑定（默认只回环；跨机访问改绑内网 IP，如 10.0.0.x:5433）----
WIRE_PG_BIND=127.0.0.1:5433

# ---- 备份保留天数（backup.sh 清理超过该天数的 gzip 文件；默认 14）----
WIRE_PG_BACKUP_RETENTION_DAYS=14
